---
type Props = {
  title?: string
  description?: string
}

const {
  title = "Betöltés folyamatban",
  description = "A kért tartalom előkészítése folyamatban van.",
} = Astro.props
---

<div class="feedback-state feedback-state--loading" role="status" aria-live="polite" aria-busy="true">
  <span class="feedback-state__marker" aria-hidden="true"></span>
  <div>
    <h2>{title}</h2>
    <p>{description}</p>
  </div>
</div>
