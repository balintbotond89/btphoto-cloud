---
type Props = {
  title?: string
  description?: string
}

const {
  title = "Még nincs megjeleníthető tartalom",
  description = "Itt jelennek meg az elérhető elemek, amint létrejönnek.",
} = Astro.props

const titleId = `empty-state-${crypto.randomUUID()}`
---

<section class="feedback-state feedback-state--empty" aria-labelledby={titleId}>
  <span class="feedback-state__marker" aria-hidden="true">00</span>
  <div>
    <h2 id={titleId}>{title}</h2>
    <p>{description}</p>
    <slot />
  </div>
</section>
