---
type Props = {
  id: string
  name: string
  label: string
  type?: "text" | "email" | "password" | "search" | "url" | "tel"
  value?: string
  placeholder?: string
  description?: string
  error?: string
  required?: boolean
  disabled?: boolean
  autocomplete?: string
}

const {
  id,
  name,
  label,
  type = "text",
  value,
  placeholder,
  description,
  error,
  required = false,
  disabled = false,
  autocomplete,
} = Astro.props

const descriptionId = description ? `${id}-description` : undefined
const errorId = error ? `${id}-error` : undefined
const describedBy = [descriptionId, errorId].filter(Boolean).join(" ") || undefined
---

<div class="ui-field" data-invalid={error ? "true" : undefined}>
  <label class="ui-field__label" for={id}>
    {label}
    {required && <span aria-hidden="true">*</span>}
  </label>
  {description && <p class="ui-field__description" id={descriptionId}>{description}</p>}
  <input
    class="ui-input"
    id={id}
    name={name}
    type={type}
    value={value}
    placeholder={placeholder}
    required={required}
    disabled={disabled}
    autocomplete={autocomplete}
    aria-invalid={error ? "true" : undefined}
    aria-describedby={describedBy}
  />
  {error && <p class="ui-field__error" id={errorId}>{error}</p>}
</div>
