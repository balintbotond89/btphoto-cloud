---
type Props = { id: string; name: string; label: string; options: string[]; required?: boolean }
const { id, name, label, options, required = false } = Astro.props
---
<div class="ui-field">
  <label class="ui-field__label" for={id}>{label}{required && <span aria-hidden="true">*</span>}</label>
  <select class="ui-input" id={id} name={name} required={required}>
    <option value="">Válassz…</option>
    {options.map((value) => <option value={value}>{value}</option>)}
  </select>
</div>
