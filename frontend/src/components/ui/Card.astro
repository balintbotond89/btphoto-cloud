---
type Props = {
  title?: string
  eyebrow?: string
  class?: string
}

const { title, eyebrow, class: className = "" } = Astro.props
---

<article class:list={["ui-card", className]}>
  {(eyebrow || title) && (
    <header class="ui-card__header">
      {eyebrow && <p class="technical-label">{eyebrow}</p>}
      {title && <h2>{title}</h2>}
    </header>
  )}
  <div class="ui-card__body"><slot /></div>
  <slot name="footer" />
</article>
