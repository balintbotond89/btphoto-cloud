---
import ErrorState from "@/components/feedback/ErrorState.astro"
import LoadingState from "@/components/feedback/LoadingState.astro"
import AccountHeader from "@/components/AccountHeader.astro"
import Input from "@/components/ui/Input.astro"
import Button from "@/components/ui/Button.astro"
import BaseLayout from "@/layouts/BaseLayout.astro"
---
<BaseLayout title="Üzemeltető | BTPhoto Private Cloud" description="Fotósregisztrációk üzemeltetői elbírálása.">
  <div class="admin-shell">
    <AccountHeader protectedView />
    <main id="fo-tartalom" class="admin-main" data-admin-session>
      <div class="admin-state" data-admin-loading>
        <LoadingState title="Munkamenet ellenőrzése" description="Üzemeltetői jogosultság ellenőrzése." />
      </div>
      <div class="admin-state" data-admin-error hidden>
        <ErrorState title="A munkamenet nem ellenőrizhető" description="Próbáld újra később.">
          <Button variant="outline" dataAction="admin-retry">Újrapróbálás</Button>
        </ErrorState>
      </div>
      <section class="admin-dashboard" data-admin-content hidden aria-labelledby="admin-title">
        <header class="admin-dashboard__header">
          <div><p class="technical-label">ÜZEMELTETŐ / ADMIN</p><h1 id="admin-title">Jóváhagyások</h1></div>
          <div class="admin-identity"><span>Bejelentkezve: <strong data-admin-username></strong></span>
            <Button variant="outline" size="small" dataAction="admin-logout">Kijelentkezés</Button>
          </div>
        </header>
        <p data-password-required hidden role="status">
          Az első belépés kizárólag jelszócserére érvényes. Az új jelszó mentése után jelentkezz be újra.
        </p>
        <section data-registration-panel hidden aria-labelledby="pending-title">
          <h2 id="pending-title">Jóváhagyásra váró fotósok</h2>
          <p class="auth-form__status" data-queue-status role="status" aria-live="polite"></p>
          <Button variant="outline" size="small" dataAction="queue-refresh">Lista frissítése</Button>
          <div class="registration-queue" data-registration-queue></div>
        </section>
        <section class="password-panel" aria-labelledby="password-title">
          <h2 id="password-title">Saját jelszó módosítása</h2>
          <form class="auth-form" data-password-form method="post" action="/api/auth/change-password">
            <div data-current-password>
              <Input id="currentPassword" name="currentPassword" label="Jelenlegi jelszó"
                type="password" autocomplete="current-password" maxlength={72} required />
            </div>
            <Input id="newPassword" name="newPassword" label="Új jelszó" type="password"
              autocomplete="new-password" required minlength={12} maxlength={72}
              description="Legalább 12 karakter, legfeljebb 72 UTF-8 bájt; nem egyezhet a jelenlegivel." />
            <Input id="confirmation" name="confirmation" label="Új jelszó megerősítése"
              type="password" autocomplete="new-password" required minlength={12} maxlength={72} />
            <p class="auth-form__status" data-password-status role="status" aria-live="polite"></p>
            <Button type="submit" dataAction="password-submit">Jelszó módosítása</Button>
          </form>
        </section>
        <p class="admin-session-status" data-admin-status role="status" aria-live="polite"></p>
      </section>
    </main>
  </div>
</BaseLayout>
<script>
  import { mountAdminSession } from "@/scripts/admin-session"
  import { mountOperator } from "@/scripts/operator"
  const root = document.querySelector<HTMLElement>("[data-admin-session]")
  if (root) { mountOperator(root); mountAdminSession(root) }
</script>
