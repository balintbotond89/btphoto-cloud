---
import LoginForm from "@/components/auth/LoginForm.astro"
import ThemeToggle from "@/components/ThemeToggle.astro"
import BaseLayout from "@/layouts/BaseLayout.astro"
---

<BaseLayout
  title="Bejelentkezés | BTPhoto Private Cloud"
  description="Közös fotós- és üzemeltetői bejelentkezés a BTPhoto Private Cloud rendszerbe."
>
  <div class="auth-shell">
    <header class="auth-header">
      <a class="wordmark" href="/" aria-label="BTPhoto Private Cloud kezdőlap">
        <span class="wordmark__mark" aria-hidden="true"></span>
        <span>
          <strong>BTPHOTO</strong>
          <small>PRIVATE CLOUD</small>
        </span>
      </a>
      <div class="site-header__actions">
        <span class="build-label">VÉDETT MUNKATERÜLET</span>
        <ThemeToggle />
      </div>
    </header>

    <main id="fo-tartalom" class="auth-main">
      <section class="auth-context" aria-labelledby="auth-context-title">
        <canvas class="hero__wave" data-wave-canvas aria-hidden="true"></canvas>
        <div class="hero__contours" aria-hidden="true"></div>
        <div class="auth-context__content">
          <p class="technical-label">BTPHOTO / PRIVATE WORKFLOW</p>
          <h2 id="auth-context-title">
            <span>BTPhoto</span>
            <span class="hero__outline">Private Cloud</span>
          </h2>
        </div>
      </section>

      <div class="auth-panel">
        <LoginForm />
      </div>
    </main>
  </div>
</BaseLayout>
